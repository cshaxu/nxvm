    {"id_suffix":"ODD-WORD-REP-PHASE-{phase}","base_selector":"I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|STOS|LODS|SCAS-REPE|SCAS-REPNE)-W","phase":["FIRST","CONTINUE","ZERO"],"count":21,"status":"missing-input"},
    {"id_suffix":"SEGMENT-ODD-WORD-REP-PHASE-{phase}","base_selector":"I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|LODS)-W","phase":["FIRST","CONTINUE","ZERO"],"count":12,"status":"missing-input"},
    {"id_suffix":"LOCK-SEGMENT-REP-PHASE-{phase}","base_selector":"I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|LODS)-(B|W)","phase":["FIRST","CONTINUE","ZERO"],"count":24,"status":"missing-input"},
    {"id_suffix":"LOCK-ODD-WORD-REP-PHASE-{phase}","base_selector":"I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|STOS|LODS|SCAS-REPE|SCAS-REPNE)-W","phase":["FIRST","CONTINUE","ZERO"],"count":21,"status":"missing-input"},
    {"id_suffix":"LOCK-SEGMENT-ODD-WORD-REP-PHASE-{phase}","base_selector":"I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|LODS)-W","phase":["FIRST","CONTINUE","ZERO"],"count":12,"status":"missing-input"}
