    {"id_suffix":"LOCK-ODD-WORD","base_selector":"I86-STRING-(MOVS|CMPS|STOS|LODS|SCAS)-W-NONE|I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|STOS|LODS|SCAS-REPE|SCAS-REPNE)-W","count":12,"status":"missing-input"},
    {"id_suffix":"SEGMENT-ODD-WORD","base_selector":"I86-STRING-(MOVS|CMPS|LODS)-W-NONE|I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|LODS)-W","count":7,"status":"missing-input"},
    {"id_suffix":"LOCK-SEGMENT-ODD-WORD","base_selector":"I86-STRING-(MOVS|CMPS|LODS)-W-NONE|I86-REP-(MOVS|CMPS-REPE|CMPS-REPNE|LODS)-W","count":7,"status":"missing-input"},
