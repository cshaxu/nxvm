cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED CORPUS_ROOT)
    set(CORPUS_ROOT "${CMAKE_CURRENT_LIST_DIR}")
endif()
file(REAL_PATH "${CORPUS_ROOT}" CORPUS_ROOT)
file(GLOB_RECURSE sources RELATIVE "${CORPUS_ROOT}" "${CORPUS_ROOT}/*.[ch]")
foreach(path IN LISTS sources)
    if(NOT path MATCHES "^(cpu|fpu|machine)/[^/]+[.][ch]$")
        message(FATAL_ERROR "Noncanonical x86-core source: ${path}")
    endif()
    file(READ "${CORPUS_ROOT}/${path}" contents)
    string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"]+[>\"]" includes "${contents}")
    foreach(include IN LISTS includes)
        string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]" "\\1" header "${include}")
        if(NOT header MATCHES "^(lib/types/|x86-core/(cpu|fpu|machine)/)")
            message(FATAL_ERROR "Forbidden x86-core include: ${path} -> ${header}")
        endif()
        if(path MATCHES "^fpu/" AND header MATCHES "^x86-core/cpu/")
            message(FATAL_ERROR "FPU cannot depend on CPU: ${path}")
        endif()
        if(path MATCHES "^(cpu|fpu)/" AND header MATCHES "^x86-core/machine/")
            message(FATAL_ERROR "CPU/FPU cannot depend on Machine: ${path}")
        endif()
        if(((path MATCHES "^machine/" AND header MATCHES "^x86-core/(cpu|fpu)/") OR
            (path MATCHES "^cpu/" AND header MATCHES "^x86-core/fpu/")) AND
           NOT header MATCHES "_interface[.]h$")
            message(FATAL_ERROR "Private chip header: ${path} -> ${header}")
        endif()
    endforeach()
    string(REGEX REPLACE "\"[^\"]*\"" "" tokens "${contents}")
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" tokens "${tokens}")
    string(REGEX REPLACE "//[^\n]*" "" tokens "${tokens}")
    if(tokens MATCHES "(^|[^A-Za-z0-9_])(memset|memcpy|memmove|memcmp|strlen|strcmp|calloc|malloc|realloc|free|snprintf|HANDLE|DWORD|LONG|HWND)([^A-Za-z0-9_]|$)")
        message(FATAL_ERROR "Raw CRT/platform vocabulary in x86-core: ${path}")
    endif()
endforeach()
set(edges_x86-core-fpu types)
set(edges_x86-core-cpu types x86-core-fpu)
set(edges_x86-core-machine types x86-core-cpu x86-core-fpu)
set(edges_x86-core-machine-observable ${edges_x86-core-machine})
file(GLOB_RECURSE build_files "${CORPUS_ROOT}/CMakeLists.txt" "${CORPUS_ROOT}/*.cmake")
foreach(path IN LISTS build_files)
    if(path MATCHES "/verify_[^/]+[.]cmake$")
        continue()
    endif()
    file(READ "${path}" build)
    string(REGEX REPLACE "#[^\n]*" "" build "${build}")
    string(TOLOWER "${build}" build)
    string(REGEX MATCHALL "target_link_libraries[ \t\r\n]*\\([^)]*\\)" links "${build}")
    foreach(link IN LISTS links)
        string(REGEX REPLACE "^target_link_libraries[ \t\r\n]*\\(|\\)$" "" args "${link}")
        string(STRIP "${args}" args)
        string(REGEX REPLACE "[ \t\r\n]+" ";" args "${args}")
        list(POP_FRONT args owner)
        foreach(dependency IN LISTS args)
            if(dependency MATCHES "^(public|private|interface)$")
                continue()
            endif()
            if(NOT DEFINED edges_${owner} OR NOT dependency IN_LIST edges_${owner})
                message(FATAL_ERROR "Forbidden x86-core build dependency: ${owner} -> ${dependency}")
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "x86-core inward CPU/FPU/Machine boundaries verified")
