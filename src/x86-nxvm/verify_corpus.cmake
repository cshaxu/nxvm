cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED CORPUS_ROOT)
    set(CORPUS_ROOT "${CMAKE_CURRENT_LIST_DIR}")
endif()
set(components board-base board-at board-xt machine product)


set(edges_board-at lib/types x86-core/machine x86-nxvm/chips/kbc8042
    x86-nxvm/chips/keyboard x86-nxvm/chips/pit825x x86-nxvm/chips/ps2mouse)
set(edges_board-xt lib/types x86-core/machine x86-nxvm/chips/ppi8255)
set(edges_board-base lib/types x86-core/machine x86-nxvm/board-at x86-nxvm/board-xt
    x86-nxvm/chips/dma8237 x86-nxvm/chips/fdc8272 x86-nxvm/chips/hdc
    x86-nxvm/chips/pic8259 x86-nxvm/chips/pit825x x86-nxvm/chips/rtc146818
    x86-nxvm/chips/video x86-nxvm/chips/xtkeyboard)
set(edges_machine lib/types lib/base lib/storage lib/kvm-base emulator/machine
    x86-core/machine x86-debug/product x86-nxvm/board-base x86-nxvm/chips/video)
set(edges_product emulator/product lib/types lib/base lib/storage
    x86-ibmpc/product x86-nxvm/machine)
foreach(chip IN ITEMS pit825x rtc146818 pic8259 dma8237 fdc8272 hdc video
        ps2mouse keyboard ppi8255 xtkeyboard kbc8042)
    list(APPEND components "chips/${chip}")
    set(edges_chips/${chip} lib/types)
endforeach()
list(APPEND edges_chips/kbc8042 x86-nxvm/chips/keyboard)

function(check_edge owner dependency)
    if(NOT dependency STREQUAL "x86-nxvm/${owner}" AND NOT dependency IN_LIST edges_${owner})
        message(FATAL_ERROR "Forbidden x86-nxvm edge: ${owner} -> ${dependency}")
    endif()
endfunction()

function(component_for_target target out_component)
    if(target STREQUAL "types" OR target STREQUAL "base" OR target STREQUAL "console" OR
       target STREQUAL "console-broker" OR target STREQUAL "storage" OR
       target STREQUAL "kvm-base" OR target STREQUAL "kvm-window" OR target STREQUAL "kvm-console")
        set(${out_component} "lib/${target}" PARENT_SCOPE)
    elseif(target MATCHES "^emulator-(machine|session|ui|product)$")
        string(REGEX REPLACE "^emulator-" "emulator/" component "${target}")
        set(${out_component} "${component}" PARENT_SCOPE)
    elseif(target STREQUAL "x86-nxvm-product")
        set(${out_component} "x86-nxvm/product" PARENT_SCOPE)
    elseif(target MATCHES "^x86-nxvm-(board-base|board-at|board-xt)(-observable)?$")
        set(${out_component} "x86-nxvm/${CMAKE_MATCH_1}" PARENT_SCOPE)
    elseif(target MATCHES "^x86-nxvm-machine(-media|-conversion)?$")
        set(${out_component} "x86-nxvm/machine" PARENT_SCOPE)
    elseif(target MATCHES "^x86-core-machine(-observable)?$")
        set(${out_component} "x86-core/machine" PARENT_SCOPE)
    elseif(target MATCHES "^x86-(ibmpc|debug)-product$")
        set(${out_component} "x86-${CMAKE_MATCH_1}/product" PARENT_SCOPE)
    elseif(target MATCHES "^x86-nxvm-chip-(.+)$")
        set(chip_component "chips/${CMAKE_MATCH_1}")
        if(NOT chip_component IN_LIST components)
            message(FATAL_ERROR "Unknown x86-nxvm chip target: ${target}")
        endif()
        set(${out_component} "x86-nxvm/${chip_component}" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unknown x86-nxvm link target: ${target}")
    endif()
endfunction()

file(GLOB_RECURSE paths RELATIVE "${CORPUS_ROOT}" "${CORPUS_ROOT}/*")
foreach(path IN LISTS paths)
    if(path MATCHES "(^|/)(win32|linux)(/|$)")
        message(FATAL_ERROR "x86-nxvm must not contain platform directories: ${path}")
    endif()
    if(NOT path MATCHES "\\.[ch]$")
        continue()
    endif()
    if(NOT path MATCHES "^(chips/[^/]+|board-base|board-at|board-xt|machine|product)/([^/]+\\.[ch]|media/[^/]+\\.[ch])$")
        message(FATAL_ERROR "Noncanonical x86-nxvm source path: ${path}")
    endif()
    set(owner "${CMAKE_MATCH_1}")
    if(NOT owner IN_LIST components)
        message(FATAL_ERROR "Unknown x86-nxvm component: ${owner}")
    endif()
    file(READ "${CORPUS_ROOT}/${path}" source)
    string(REGEX REPLACE "\"[^\"]*\"" "" tokens "${source}")
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" "" tokens "${tokens}")
    string(REGEX REPLACE "//[^\n]*" "" tokens "${tokens}")
    if(tokens MATCHES "(^|[^A-Za-z0-9_])(memset|memcpy|memmove|memcmp|memchr|strlen|strcmp|strchr|strtok|calloc|malloc|realloc|free|snprintf)([^A-Za-z0-9_]|$)")
        message(FATAL_ERROR "Raw CRT vocabulary in x86-nxvm; use Lib Types: ${path}")
    endif()
    if(tokens MATCHES "(^|[^A-Za-z0-9_])(U?INT[A-Z0-9_]*|SIZE|PTRDIFF|WCHAR|WINT)_(MAX|MIN)([^A-Za-z0-9_]|$)")
        message(FATAL_ERROR "Raw integer limit in x86-nxvm; use Lib Types: ${path}")
    endif()
    if(tokens MATCHES "_WIN32|_WIN64|__linux__|WINAPI|CRITICAL_SECTION|WaitForSingleObject|CreateEvent[A-W]?|pthread_")
        message(FATAL_ERROR "Platform implementation in x86-nxvm: ${path}")
    endif()
    string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"]+[>\"]" includes "${source}")
    foreach(include IN LISTS includes)
        string(REGEX REPLACE ".*[<\"]([^>\"]+)[>\"]" "\\1" header "${include}")
        if(NOT header MATCHES "^(x86-nxvm/(chips/[^/]+|board-base|board-at|board-xt|machine|product)|x86-(core|debug|ibmpc)/[^/]+|emulator/[^/]+|lib/[^/]+)/([^/]+\\.h|media/[^/]+\\.h)$")
            message(FATAL_ERROR "Noncanonical x86-nxvm include: ${header}")
        endif()
        get_filename_component(dependency "${header}" DIRECTORY)
        get_filename_component(file "${header}" NAME)
        if(dependency STREQUAL "x86-nxvm/machine/media")
            set(dependency "x86-nxvm/machine")
        endif()
        check_edge("${owner}" "${dependency}")
        if(dependency STREQUAL "x86-nxvm/${owner}")
            string(REGEX REPLACE "^x86-nxvm/" "" local_header "${header}")
            if(NOT EXISTS "${CORPUS_ROOT}/${local_header}")
                message(FATAL_ERROR "Missing local x86-nxvm header: ${header}")
            endif()
        elseif(NOT dependency STREQUAL "lib/types" AND NOT file MATCHES "_interface\\.h$")
            message(FATAL_ERROR "Private dependency in x86-nxvm: ${header}")
        endif()
    endforeach()
endforeach()

file(READ "${CORPUS_ROOT}/CMakeLists.txt" build_source)
string(REGEX REPLACE "#[^\n]*" "" build_source "${build_source}")
# The chip factory is deliberately limited to a single source and Types.
# Check its complete body before excluding its parameterized link statement.
set(expected_chip_factory "function(x86_nxvm_add_chip target source)\n    add_library(\${target} STATIC \${source})\n    target_include_directories(\${target} PUBLIC \${X86_NXVM_SOURCE_ROOT})\n    target_link_libraries(\${target} PUBLIC types)\nendfunction()")
string(REPLACE "\r" "" build_source "${build_source}")
string(FIND "${build_source}" "${expected_chip_factory}" chip_factory_position)
if(chip_factory_position EQUAL -1)
    message(FATAL_ERROR "Unexpected x86-nxvm chip factory contract")
endif()
string(REPLACE "${expected_chip_factory}" "" build_source "${build_source}")
string(REGEX MATCHALL "x86_nxvm_add_chip\\([^)]*\\)" chip_calls "${build_source}")
foreach(call IN LISTS chip_calls)
    if(NOT call MATCHES "^x86_nxvm_add_chip\\((x86-nxvm-chip-([^ ]+)) (chips/[^ ]+)\\)$")
        message(FATAL_ERROR "Noncanonical x86-nxvm chip declaration: ${call}")
    endif()
    set(chip "${CMAKE_MATCH_2}")
    set(source "${CMAKE_MATCH_3}")
    if(NOT "chips/${chip}" IN_LIST components OR NOT source MATCHES "^chips/${chip}/[^/]+\\.c$" OR
       NOT EXISTS "${CORPUS_ROOT}/${source}")
        message(FATAL_ERROR "Invalid x86-nxvm chip source: ${call}")
    endif()
endforeach()
string(REGEX MATCHALL "target_link_libraries[ \t\r\n]*\\([^)]*\\)" links "${build_source}")
foreach(link IN LISTS links)
    string(REGEX REPLACE "^target_link_libraries[ \t\r\n]*\\(|\\)$" "" args "${link}")
    string(REGEX REPLACE "[ \t\r\n]+" ";" args "${args}")
    list(POP_FRONT args target)
    component_for_target("${target}" owner_component)
    string(REGEX REPLACE "^x86-nxvm/" "" owner "${owner_component}")
    foreach(dependency_target IN LISTS args)
        if(dependency_target MATCHES "^(PUBLIC|PRIVATE|INTERFACE)$" OR dependency_target STREQUAL "")
            continue()
        endif()
        component_for_target("${dependency_target}" dependency)
        check_edge("${owner}" "${dependency}")
    endforeach()
endforeach()
message(STATUS "x86-nxvm platform and component boundaries verified")
