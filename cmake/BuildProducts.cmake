cmake_minimum_required(VERSION 3.23)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(products nxvm my5160 my5170 mydeskpro386 mypc110 mynes myraidenii)
string(TOLOWER "${PRODUCT}" PRODUCT)
if(PRODUCT STREQUAL "all")
    set(selected ${products})
elseif(PRODUCT IN_LIST products)
    set(selected "${PRODUCT}")
else()
    message(FATAL_ERROR "Unknown product: ${PRODUCT}")
endif()
find_program(ninja NAMES ninja REQUIRED)
find_program(ccache NAMES ccache)
set(use_cache OFF)
if(ccache)
    set(use_cache ON)
else()
    message(STATUS "ccache not found; using Ninja incremental builds without compiler cache")
endif()
find_program(compiler_x64 NAMES gcc REQUIRED)
if(NOT "$ENV{NXVM_I686_GCC}" STREQUAL "")
    set(compiler_x86 "$ENV{NXVM_I686_GCC}")
    if(NOT EXISTS "${compiler_x86}")
        message(FATAL_ERROR "NXVM_I686_GCC does not exist")
    endif()
else()
    find_program(compiler_x86 NAMES i686-w64-mingw32-gcc REQUIRED)
endif()
foreach(arch IN ITEMS x86 x64)
    set(tree "${root}/build/.ninja/gcc-${arch}-release")
    foreach(app IN LISTS selected)
        set(pc ON)
        set(profile default-pc-at-80386-1440k-hdd)
        if(app STREQUAL "my5160")
            set(profile ibm-5160-model-268-360k)
        elseif(app STREQUAL "my5170")
            set(profile ibm-5170-model-339-1200k)
        elseif(app STREQUAL "mydeskpro386")
            set(profile compaq-deskpro-386-model-40-1200k)
        elseif(app STREQUAL "mynes" OR app STREQUAL "myraidenii")
            set(pc OFF)
        endif()
        message(STATUS "Building and publishing ${app} ${arch}")
        execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${tree}" -G Ninja
            "-DCMAKE_MAKE_PROGRAM=${ninja}" "-DCMAKE_C_COMPILER=${compiler_${arch}}"
            -DCMAKE_BUILD_TYPE=Release "-DPROJECT_ARTIFACT_ARCHITECTURE=${arch}"
            "-DREPOSITORY_USE_CCACHE=${use_cache}" "-DREPOSITORY_BUILD_NXVM=${pc}"
            -DREPOSITORY_BUILD_MYNES=ON -DREPOSITORY_BUILD_MYRAIDENII=ON
            "-DNXVM_PRODUCT_PROFILE=${profile}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" --build "${tree}"
            --target "publish-${app}" --parallel 8 COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endforeach()
message(STATUS "Both architectures published under assets/<product>/")
