if(NOT DEFINED PROJECT_SOURCE_DIR)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR is required")
endif()

file(READ "${PROJECT_SOURCE_DIR}/src/x86-core/machine/machine_scheduler.c" core)
file(READ "${PROJECT_SOURCE_DIR}/src/x86-nxvm/board-base/board_advance.c" board)
file(READ "${PROJECT_SOURCE_DIR}/src/x86-nxvm/board-base/machine_board.c" creation)
foreach(effect "x86_nxvm_board_fdc_advance_at(" "x86_nxvm_board_hdc_advance_at("
    "x86_rtc_advance(")
    string(FIND "${core}" "${effect}" core_position)
    string(FIND "${board}" "${effect}" board_position)
    if(NOT core_position LESS 0 OR board_position LESS 0)
        message(FATAL_ERROR "Readiness effect has wrong owner: ${effect}")
    endif()
endforeach()
string(FIND "${board}" "x86_fpu_advance(" board_fpu)
if(NOT board_fpu LESS 0)
    message(FATAL_ERROR "Board owns Core FPU advancement")
endif()
string(FIND "${core}" "machine->attachment.before_internal_advance(machine->attachment.context," before_internal)
string(FIND "${core}" "x86_core_machine_internal_advance(machine, source_ticks);" internal)
string(FIND "${core}" "machine->attachment.after_internal_advance(machine->attachment.context," after_internal)
string(FIND "${core}" "x86_fpu_advance(machine->fpu, source_ticks);" fpu)
string(FIND "${core}" "x86_core_cpu_execution_advance_wait(" wait)
if(before_internal LESS 0 OR internal LESS before_internal OR
   after_internal LESS internal OR fpu LESS 0 OR wait LESS fpu)
    message(FATAL_ERROR "Core lost board/internal readiness order")
endif()
string(FIND "${board}" "x86_nxvm_board_pic_refresh(" pic)
string(FIND "${board}" "x86_nxvm_board_fdc_advance_at(" fdc)
string(FIND "${board}" "x86_nxvm_board_hdc_advance_at(" hdc)
string(FIND "${board}" "void x86_nxvm_board_after_internal_advance(" after_boundary)
string(FIND "${board}" "x86_rtc_advance(" rtc)
if(pic LESS 0 OR fdc LESS pic OR hdc LESS fdc OR
   after_boundary LESS hdc OR rtc LESS after_boundary)
    message(FATAL_ERROR "Board lost PIT/PIC-media and RTC phase ownership")
endif()
foreach(binding "x86_nxvm_board_before_internal_advance" "x86_nxvm_board_after_internal_advance")
    string(FIND "${creation}" "${binding}" position)
    if(position LESS 0)
        message(FATAL_ERROR "Readiness provider is not bound: ${binding}")
    endif()
endforeach()
message("BOARD-READINESS:OK")
