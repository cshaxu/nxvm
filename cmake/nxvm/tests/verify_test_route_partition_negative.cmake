cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED WORK)
    message(FATAL_ERROR "WORK is required")
endif()
file(MAKE_DIRECTORY "${WORK}")
foreach(probe IN ITEMS absolute foreign valid)
    set(name x86-nxvm.chips/pit825x/pit_8253)
    set(owner x86-nxvm)
    if(probe STREQUAL absolute)
        set(name "x86-nxvm.O:/fixture/chips/pit825x/pit_8253")
        set(expected "filesystem path")
    elseif(probe STREQUAL foreign)
        set(name x86-core.chips/pit825x/pit_8253)
        set(owner x86-core)
        set(expected "foreign owner")
    endif()
    file(WRITE "${WORK}/CTestTestfile.cmake"
        "add_test([=[${name}]=] ignored)\n"
        "set_tests_properties([=[${name}]=] PROPERTIES LABELS \"unit;${owner}\" _BACKTRACE_TRIPLES \"/fixture/test/x86-nxvm/x86_tests.cmake;1;shared_register_test;\")\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_DIRECTORY=${WORK}"
        -P "${CMAKE_CURRENT_LIST_DIR}/verify_test_route_partition.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(probe STREQUAL valid)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid X86 NXVM identity rejected: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "${probe} probe did not reject its violation: ${output}${error}")
    endif()
endforeach()
message(STATUS "TEST-ROUTE-PARTITION-NEGATIVE:OK")
