file(GLOB_RECURSE mypc110_sources "${CMAKE_SOURCE_DIR}/src/app-mypc110/*.c"
    "${CMAKE_SOURCE_DIR}/src/app-mypc110/*.h")
foreach(source IN LISTS mypc110_sources)
    file(READ "${source}" text)
    if(text MATCHES "#[ \t]*include[^\n]*app-(nxvm|my5160|my5170|mydeskpro386)/")
        message(FATAL_ERROR "MyPC110 includes a peer App: ${source}")
    endif()
    if(text MATCHES "x86-nxvm/machine/pc_at_preparation")
        message(FATAL_ERROR "MyPC110 uses the excluded PC/AT preparation path: ${source}")
    endif()
endforeach()
set(PROJECT_APP_TEST_OWNER "app-mypc110")
include("${CMAKE_SOURCE_DIR}/cmake/nxvm/verify_app_test_support_boundary.cmake")
unset(PROJECT_APP_TEST_OWNER)
message(STATUS "MyPC110 independent App boundary: OK")
