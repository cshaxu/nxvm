{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-gcc-x64",
      "displayName": "MinGW-w64 GCC x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-gcc-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "nxvm-current-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-0-5-0184"]
    },
    {
      "name": "nxvm-current-gates-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": [
        "nxvm-vm-two-session-isolation-smoke",
        "nxvm-vm-core-executor-storage-smoke",
        "nxvm-core-executor-run-smoke",
        "nxvm-core-machine-trace-context-smoke",
        "nxvm-core-machine-cpu-fault-diagnostic-smoke",
        "nxvm-core-machine-lifecycle-contract-smoke",
        "nxvm-core-machine-ram-port-context-smoke",
        "nxvm-core-machine-stopped-lifecycle-smoke",
        "nxvm-core-machine-memory-reconfigure-smoke",
        "nxvm-core-product-wait-smoke",
        "nxvm-core-product-session-contract-smoke",
        "nxvm-core-product-session-manager-smoke",
        "nxvm-core-product-debug-target-smoke",
        "nxvm-vm-platform-surface-context-smoke",
        "nxvm-vm-platform-execution-smoke",
        "nxvm-vm-platform-run-handle-smoke",
        "nxvm-vm-multi-window-session-smoke",
        "nxvm-vm-platform-input-smoke",
        "nxvm-vm-keyboard-host-ingress-smoke",
        "nxvm-vm-platform-presentation-mailbox-smoke",
        "nxvm-vm-platform-mode-context-smoke",
        "nxvm-vm-dos-prompt-smoke",
        "nxvm-vm-dos-keyboard-smoke",
        "nxvm-vm-dos-mem-fault-smoke",
        "nxvm-vm-qdcga-boundary-smoke",
        "nxvm-vm-debug-pause-boundary-smoke",
        "nxvm-vm-unified-debug-backend-smoke",
        "nxvm-product-console-smoke",
        "nxvm-product-console-lifecycle-gate",
        "nxvm-vm-debug-target-smoke",
        "nxvm-vm-keyboard-provider-isolation-smoke",
        "nxvm-product-session-smoke",
        "nxvm-vm-session-manager-smoke",
        "ntvdm64-core-platform-host-surface-smoke",
        "ntvdm64-vdm-minimal-session-smoke",
        "nxvm-dos-minimal-presentation-smoke",
        "verify-dependency-dag",
        "verify-live-machine-authority",
        "verify-facade-ownership",
        "verify-executor-closure",
        "verify-session-readiness",
        "verify-product-session-manager",
        "verify-c-facade-headers",
        "verify-vm-provider-composition",
        "verify-ram-reconfigure-closure",
        "nxvm-vm-session-reconfigure-smoke"
