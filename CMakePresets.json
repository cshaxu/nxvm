{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-gcc-x64",
      "displayName": "MinGW-w64 GCC x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-gcc-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64"
    }
  ],
  "buildPresets": [
    {
      "name": "m0-probe-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["generate-m1-probe"]
    },
    {
      "name": "m1-baseline-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-baseline"]
    },
    {
      "name": "m3-core-contract-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-core-contract-smoke"]
    },
    {
      "name": "m3-machine-instance-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-core-machine-instance-smoke"]
    },
    {
      "name": "m3-machine-lifecycle-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-core-machine-lifecycle-smoke"]
    },
    {
      "name": "m3-machine-trace-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-core-machine-trace-smoke"]
    },
    {
      "name": "m3-full-pc-profile-gcc",
      "configurePreset": "mingw-gcc-x64",
      "targets": ["nxvm-full-pc-profile-smoke"]
    },
    {
      "name": "m0-probe-msvc",
      "configurePreset": "vs2022-x64",
      "targets": ["generate-m1-probe"],
      "configuration": "Debug"
    }
  ]
}
