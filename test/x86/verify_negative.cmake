cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED X86_ROOT OR NOT DEFINED PROBE_ROOT)
    message(FATAL_ERROR "Explicit x86 and probe roots required")
endif()
file(MAKE_DIRECTORY "${PROBE_ROOT}/debug" "${PROBE_ROOT}/xasm32")
file(MAKE_DIRECTORY "${PROBE_ROOT}/devices/pit825x")
file(MAKE_DIRECTORY "${PROBE_ROOT}/devices/rtc146818")
file(MAKE_DIRECTORY "${PROBE_ROOT}/devices/pic8259")
function(reject owner source build expected)
    file(WRITE "${PROBE_ROOT}/${owner}/probe.c" "${source}")
    file(WRITE "${PROBE_ROOT}/CMakeLists.txt" "${build}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DX86_ROOT=${PROBE_ROOT}
        -P "${X86_ROOT}/verify_corpus.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(REMOVE "${PROBE_ROOT}/${owner}/probe.c")
    if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
        message(FATAL_ERROR "Expected rejection ${expected}, got ${result}: ${output}${error}")
    endif()
endfunction()
