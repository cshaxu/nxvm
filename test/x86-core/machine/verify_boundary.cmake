cmake_minimum_required(VERSION 3.23)
if(NOT DEFINED MACHINE_TEST_ROOT)
    set(MACHINE_TEST_ROOT "${CMAKE_CURRENT_LIST_DIR}")
endif()
file(REAL_PATH "${MACHINE_TEST_ROOT}" MACHINE_TEST_ROOT)
file(GLOB_RECURSE sources "${MACHINE_TEST_ROOT}/*.[ch]")
foreach(path IN LISTS sources)
    get_filename_component(directory "${path}" DIRECTORY)
    file(STRINGS "${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    foreach(line IN LISTS includes)
        string(REGEX REPLACE ".*include[ \t]*\"([^\"]+)\".*" "\\1" header "${line}")
        if(header MATCHES "^(lib/types/|x86-core/machine/)")
            continue()
        elseif(header MATCHES "^x86-core/(cpu|fpu)/")
            if(NOT header MATCHES "_interface[.]h$")
                message(FATAL_ERROR "Machine test borrows private chip header: ${path} -> ${header}")
            endif()
        else()
            get_filename_component(resolved "${directory}/${header}" ABSOLUTE)
            cmake_path(IS_PREFIX MACHINE_TEST_ROOT "${resolved}" NORMALIZE owned)
            if(NOT owned)
                message(FATAL_ERROR "Machine test borrows a foreign fixture: ${path} -> ${header}")
            endif()
        endif()
    endforeach()
    file(READ "${path}" content)
    if(content MATCHES "x86_core_cpu_execution_context_bind_profiles[ \t\r\n]*\\(" OR
            content MATCHES "->[ \t\r\n]*cpu_profile[ \t\r\n]*=([^=]|$)")
        message(FATAL_ERROR "Machine tests must use configured CPU profile: ${path}")
    endif()
endforeach()
message(STATUS "Machine tests own their fixtures and use public chip contracts")
