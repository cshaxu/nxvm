check(ibmpc "#include \"../x86/core/fixture.h\"" "" "Foreign")
check(lib "#include \"common/machine/machine_interface.h\"" "" "Outward")
check(common "#include \"x86/debug/debug_interface.h\"" "" "Outward")
check(x86 "#include \"ibmpc/board.h\"" "" "Outward")
check(x86 "#include \"../common/machine_fixture.h\"" "" "Foreign")
