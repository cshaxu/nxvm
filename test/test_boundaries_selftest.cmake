check(x86 "" "target_sources(probe PRIVATE ../common/machine_fixture.c)" "Foreign")
check(x86 "" "target_link_libraries(probe PRIVATE ibmpc-board-common)" "Outward")
check(common "" "target_link_libraries(probe PRIVATE x86-core)" "Outward")
check(lib "" "target_link_libraries(probe PRIVATE common-machine)" "Outward")
