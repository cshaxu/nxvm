if(NOT DEFINED TEST_WORK_DIR)
    message(FATAL_ERROR "TEST_WORK_DIR required")
endif()
set(probe "${TEST_WORK_DIR}/test-boundary-probe")
file(MAKE_DIRECTORY "${probe}")
function(check layer source build expected)
    file(WRITE "${probe}/probe.c" "${source}\n")
    file(WRITE "${probe}/CMakeLists.txt" "${build}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_ROOT=${probe}"
        "-DTEST_LAYER=${layer}" -P "${CMAKE_CURRENT_LIST_DIR}/verify_test_boundaries.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Valid boundary rejected: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "Missing boundary rejection ${expected}: ${output}${error}")
    endif()
endfunction()
