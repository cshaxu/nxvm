if(NOT DEFINED TEST_WORK_DIR)
    message(FATAL_ERROR "TEST_WORK_DIR required")
endif()
foreach(case IN ITEMS unit integration both neither desktop audio)
    set(root "${TEST_WORK_DIR}/registration-${case}")
    file(MAKE_DIRECTORY "${root}")
    if(case STREQUAL "integration")
        set(labels "integration;lib;native_audio")
    elseif(case STREQUAL "both")
        set(labels "unit;integration;lib")
    elseif(case STREQUAL "neither")
        set(labels "lib")
    elseif(case STREQUAL "desktop")
        set(labels "unit;lib;desktop")
    elseif(case STREQUAL "audio")
        set(labels "unit;lib;native_audio")
    else()
        set(labels "unit;lib")
    endif()
    file(WRITE "${root}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.23)\nproject(registration NONE)\nenable_testing()\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/register.cmake\")\nadd_test(NAME lib.probe COMMAND \"${CMAKE_COMMAND}\" -E true)\nset_tests_properties(lib.probe PROPERTIES LABELS \"${labels}\")\nshared_verify_test_registration(lib)\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(case STREQUAL "unit" OR case STREQUAL "integration")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Legal ${case} registration rejected: ${error}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Illegal ${case} registration accepted")
    endif()
endforeach()
