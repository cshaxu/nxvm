# Exercise the actual publisher with a built binary, never user assets.
set(work "${TEST_WORK_DIR}/publication")
file(MAKE_DIRECTORY "${work}")
set(output "${work}/output/program.exe")
set(publish "${REPOSITORY_ROOT}/cmake/PublishProduct.cmake")
function(run_publish)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${INPUT}"
        "-DOUTPUT=${output}"
        -P "${publish}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
run_publish()
file(SHA256 "${output}" original)
file(SHA256 "${INPUT}" built)
if(NOT original STREQUAL built)
    message(FATAL_ERROR "Published executable differs from its built target")
endif()
run_publish()
file(SHA256 "${output}" repeated)
if(NOT original STREQUAL repeated)
    message(FATAL_ERROR "Unchanged publication changed executable bytes")
endif()
file(REMOVE "${output}")
run_publish()
file(SHA256 "${output}" restored)
if(NOT original STREQUAL restored)
    message(FATAL_ERROR "Publication did not restore the missing output")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${work}/absent"
    "-DOUTPUT=${output}" -P "${publish}" RESULT_VARIABLE result
    OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${output}" retained)
if(result EQUAL 0 OR NOT original STREQUAL retained)
    message(FATAL_ERROR "Missing input was accepted or damaged the published file")
endif()
execute_process(COMMAND cmd /d /c "${REPOSITORY_ROOT}/tools/build.cmd" invalid --no-pause
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "Unknown product")
    message(FATAL_ERROR "CMD did not propagate invalid-product failure")
endif()
file(REMOVE "${work}/output/program.exe")
