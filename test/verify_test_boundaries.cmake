if(NOT DEFINED TEST_ROOT OR NOT DEFINED TEST_LAYER)
    message(FATAL_ERROR "TEST_ROOT and TEST_LAYER are required")
endif()
set(layers lib emulator x86-debug x86-ibmpc x86-nxvm x86-core)
if(NOT TEST_LAYER IN_LIST layers)
    message(FATAL_ERROR "Unknown test layer: ${TEST_LAYER}")
endif()
set(allowed_lib lib)
set(allowed_emulator lib emulator)
set(allowed_x86-debug lib emulator x86-debug)
set(allowed_x86-ibmpc lib emulator x86-debug x86-ibmpc)
set(allowed_x86-nxvm lib emulator x86-debug x86-ibmpc x86-core x86-nxvm)
set(allowed_x86-core lib x86-core)
file(REAL_PATH "${TEST_ROOT}" root)
string(REPLACE [=[\;]=] ";" test_exclude_directories
    "${TEST_EXCLUDE_DIRECTORIES}")
set(excluded_directories)
foreach(excluded_directory IN LISTS test_exclude_directories)
    if(NOT IS_DIRECTORY "${excluded_directory}")
        message(FATAL_ERROR "Test boundary exclusion is not a directory: ${excluded_directory}")
    endif()
    file(REAL_PATH "${excluded_directory}" excluded_directory)
    list(APPEND excluded_directories "${excluded_directory}")
endforeach()
if(DEFINED TEST_SOURCE_ROOT)
    file(REAL_PATH "${TEST_SOURCE_ROOT}" source_root)
    # Reuse the production dependency authority, not a second test-only DAG.
    if(TEST_LAYER STREQUAL "lib")
        set(LIBRARY_ROOT "${source_root}")
        include("${source_root}/verify_component_dependencies.cmake")
    elseif(TEST_LAYER STREQUAL "emulator")
        set(EMULATOR_ROOT "${source_root}")
        include("${source_root}/verify_corpus.cmake")
    endif()
endif()
file(GLOB_RECURSE files "${root}/*.c" "${root}/*.h")
foreach(path IN LISTS files)
    set(excluded FALSE)
    foreach(excluded_directory IN LISTS excluded_directories)
        file(RELATIVE_PATH exclusion_relative_path
            "${excluded_directory}" "${path}")
        if(NOT exclusion_relative_path MATCHES "^([.][.]/|[.][.]$)")
            set(excluded TRUE)
            break()
        endif()
    endforeach()
    if(excluded)
        continue()
    endif()
    if(path MATCHES "/fixtures/")
        continue() # Deliberately invalid static-check inputs, not executables.
    endif()
    get_filename_component(directory "${path}" DIRECTORY)
    file(RELATIVE_PATH relative "${root}" "${path}")
    set(unit_owner "")
    if(DEFINED TEST_SOURCE_ROOT AND NOT relative MATCHES "^integration/")
        if(relative MATCHES "^audio/(pcm|midi|fm)/")
            set(unit_directory "audio/${CMAKE_MATCH_1}")
            set(unit_owner "audio-${CMAKE_MATCH_1}")
        elseif(relative MATCHES "^([^/]+)/")
            set(unit_directory "${CMAKE_MATCH_1}")
            set(unit_owner "${unit_directory}")
        endif()
        if(unit_owner STREQUAL "" OR NOT IS_DIRECTORY "${source_root}/${unit_directory}")
            message(FATAL_ERROR "Unit needs a source owner directory: ${relative}")
        endif()
        get_filename_component(unit_path "${relative}" DIRECTORY)
        if(NOT IS_DIRECTORY "${source_root}/${unit_path}")
            message(FATAL_ERROR "Unit directory has no source counterpart: ${relative}")
        endif()
    endif()
    if(TEST_LAYER MATCHES "^x86-(core|nxvm)$")
        file(READ "${path}" source)
        if(relative MATCHES "(^|/)core_machine_" OR
           source MATCHES "(^|[^A-Za-z0-9_])(core_machine_|CORE_MACHINE_|test_core_|TEST_CORE_|TEST_IBMPC_)")
            message(FATAL_ERROR "Retired test owner name: ${relative}")
        endif()
    endif()
    file(STRINGS "${path}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    foreach(line IN LISTS includes)
        string(REGEX REPLACE "^.*include[ \t]*\"([^\"]+)\".*$" "\\1" header "${line}")
        if(header MATCHES "^(lib|emulator|x86-debug|x86-ibmpc|x86-nxvm|x86-core)/")
            if(NOT CMAKE_MATCH_1 IN_LIST allowed_${TEST_LAYER})
                message(FATAL_ERROR "Outward test include: ${path}: ${header}")
            endif()
            set(dependency_layer "${CMAKE_MATCH_1}")
            if(NOT unit_owner STREQUAL "" AND dependency_layer STREQUAL TEST_LAYER)
                string(LENGTH "${dependency_layer}/" prefix_length)
                string(SUBSTRING "${header}" ${prefix_length} -1 local_header)
                if(TEST_LAYER STREQUAL "lib")
                    library_source_owner("${local_header}" dependency_owner unused)
                    library_check_edge("${unit_owner}" "${dependency_owner}")
                    if(local_header MATCHES "/(win32|linux)/" AND
                       NOT dependency_owner STREQUAL "types" AND
                       NOT dependency_owner STREQUAL unit_owner)
                        message(FATAL_ERROR "Foreign private platform fixture: ${relative}: ${header}")
                    endif()
                elseif(TEST_LAYER STREQUAL "emulator")
                    string(REGEX MATCH "^[^/]+" dependency_owner "${local_header}")
                    check_edge("${unit_owner}" "${dependency_owner}")
                endif()
            endif()
            string(REGEX REPLACE "^${TEST_LAYER}/" "" dependency "${header}")
        elseif(header MATCHES "^(app[^/]*|core|vm|compat)/")
            message(FATAL_ERROR "Outward test include: ${path}: ${header}")
        else()
            get_filename_component(resolved "${directory}/${header}" ABSOLUTE)
            cmake_path(IS_PREFIX root "${resolved}" NORMALIZE local)
            if(NOT local)
                message(FATAL_ERROR "Foreign test fixture: ${path}: ${header}")
            endif()
            file(RELATIVE_PATH dependency "${root}" "${resolved}")
        endif()
        if(TEST_LAYER STREQUAL "x86-nxvm" AND
           ((relative MATCHES "^board-(at|xt)/" AND dependency MATCHES "^(board-base|machine|product)/") OR
            (relative MATCHES "^chips/" AND dependency MATCHES "^(board-[^/]+|machine|product)/")))
            message(FATAL_ERROR "Outward test component include: ${relative} -> ${header}")
        endif()
    endforeach()
endforeach()
set(build "")
set(pending "${root}/CMakeLists.txt")
set(visited)
while(pending)
    list(POP_FRONT pending path)
    if(path IN_LIST visited)
        continue()
    endif()
    list(APPEND visited "${path}")
    file(READ "${path}" source)
    string(REGEX REPLACE "#[^\n]*" "" source "${source}")
    string(APPEND build "\n${source}")
    get_filename_component(directory "${path}" DIRECTORY)
    string(REGEX MATCHALL "[Ii][Nn][Cc][Ll][Uu][Dd][Ee][ \t\r\n]*\\([^)]*\\)" includes "${source}")
    foreach(include IN LISTS includes)
        string(REGEX REPLACE "^[^(]*\\([ \t\r\n]*\"?|\"?[ \t\r\n]*\\)$" "" target "${include}")
        string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${directory}" target "${target}")
        get_filename_component(target "${target}" ABSOLUTE BASE_DIR "${directory}")
        cmake_path(IS_PREFIX root "${target}" NORMALIZE local)
        if(local)
            list(APPEND pending "${target}")
        elseif(NOT target STREQUAL "${root}/../register.cmake")
            get_filename_component(register "${root}/../register.cmake" ABSOLUTE)
            if(NOT target STREQUAL register)
                message(FATAL_ERROR "Foreign test build include: ${path}: ${include}")
            endif()
        endif()
    endforeach()
endwhile()
if(TEST_LAYER STREQUAL "lib")
    set(outer "emulator-|x86-|ibmpc-|core-|product-")
elseif(TEST_LAYER STREQUAL "emulator")
    set(outer "x86-|ibmpc-|core-|product-")
elseif(TEST_LAYER STREQUAL "x86-debug")
    set(outer "x86-ibmpc-|x86-nxvm-|x86-core-|core-")
elseif(TEST_LAYER STREQUAL "x86-ibmpc")
    set(outer "x86-nxvm-|x86-core-|core-")
elseif(TEST_LAYER STREQUAL "x86-nxvm")
    set(outer "app-|softpc-|core-")
elseif(TEST_LAYER STREQUAL "x86-core")
    set(outer "emulator-|x86-debug-|x86-ibmpc-|x86-nxvm-|core-")
else()
    set(outer "app-|softpc-")
endif()
string(TOLOWER "${build}" link_source)
if(TEST_LAYER STREQUAL "x86-nxvm" AND link_source MATCHES
   "shared_register_test[ \t\r\n]*\\([ \t\r\n]*x86-nxvm[ \t\r\n]+board-(at|xt)/[^)]*[ \t\r\n]+x86-nxvm-(board-base|machine|product)")
    message(FATAL_ERROR "Outward test component link: ${root}")
endif()
if(link_source MATCHES "(target_link_libraries|shared_register_test)[ \t\r\n]*\\([^)]*[ \t\r\n](${outer})")
    message(FATAL_ERROR "Outward test link: ${root}")
endif()
# Source-root discovery uses ../../src; sibling suite paths never do.
if(build MATCHES "(CURRENT_LIST_DIR|CURRENT_SOURCE_DIR)}/[.][.]/(lib|emulator|x86-debug|x86-ibmpc|x86-nxvm|x86-core|core)(/|\")" OR
   build MATCHES "[ \t\n\"]([.][.]/)+(lib|emulator|x86-debug|x86-ibmpc|x86-nxvm|x86-core|core)/")
    message(FATAL_ERROR "Foreign test package in build: ${root}")
endif()
message(STATUS "${TEST_LAYER} test ownership and inward includes verified")
