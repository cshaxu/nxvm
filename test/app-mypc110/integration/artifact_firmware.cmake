foreach(name IN ITEMS PROJECT_ARTIFACT_PATH PROJECT_ARTIFACT_ARCHITECTURE
        DEPLOYED_PATH EXPECTED_BIOS OTHER_BIOS FONT_FILE SOURCE_ROOT)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "Missing artifact verification input: ${name}")
    endif()
endforeach()

include("${SOURCE_ROOT}/src/x86-nxvm/product/verify_artifact_architecture.cmake")
file(SHA256 "${PROJECT_ARTIFACT_PATH}" built_hash)
file(SHA256 "${DEPLOYED_PATH}" deployed_hash)
if(NOT built_hash STREQUAL deployed_hash)
    message(FATAL_ERROR "Deployed PC110 artifact differs from its built target")
endif()

file(READ "${PROJECT_ARTIFACT_PATH}" image HEX)
foreach(role IN ITEMS EXPECTED_BIOS OTHER_BIOS FONT_FILE)
    file(READ "${${role}}" expected HEX)
    string(FIND "${image}" "${expected}" offset)
    if(role STREQUAL "OTHER_BIOS")
        if(NOT offset EQUAL -1)
            message(FATAL_ERROR "PC110 artifact contains the other panel's firmware")
        endif()
    elseif(offset EQUAL -1)
        message(FATAL_ERROR "PC110 artifact is missing ${role}")
    endif()
endforeach()
message(STATUS "PC110 artifact firmware identity verified")
